# The android/ (and other platform) folders are intentionally NOT committed.
# The CI workflow (.github/workflows/build-apk.yml) regenerates them fresh
# on every run via `flutter create --platforms=android .`, so this repo only
# needs to track lib/, assets/, and pubspec.yaml.
